# Copy to .env and fill in. Never commit .env.

# Primary model: any OpenAI-compatible chat completions endpoint (base URL WITHOUT /chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional backup model (different provider recommended)
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=

# Optional tuning
LLM_TIMEOUT_S=8
REQUEST_DEADLINE_S=20
ENABLE_DEGRADED_FALLBACK=true
CACHE_SIZE=512
LOG_LEVEL=INFO
PORT=8000
